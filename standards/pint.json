{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "class_attributes_separation": {
            "elements": {
                "method": "one"
            }
        },
        "explicit_string_variable": true,
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": true,
            "import_functions": true
        },
        "php_unit_test_annotation": {
            "style": "annotation"
        },
        "simple_to_complex_string_variable": true
    }
}
